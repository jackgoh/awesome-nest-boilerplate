{
  "name": "awesome-nest-boilerplate",
  "version": "0.0.1",
  "description": "",
  "author": "Jack <darryl.42730810@nicoric.com>",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24.16.0",
    "pnpm": ">=11.12.0"
  },
  "scripts": {
    "build:prod": "tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit --skipLibCheck",
    "type-check:compat": "tsc6 --noEmit --skipLibCheck",
    "type-check:test": "tsc -p tsconfig.test.json",
    "type-check:test:compat": "tsc6 -p tsconfig.test.json",
    "start:dev": "ts-node src/main.ts",
    "start:prod": "node --enable-source-maps dist/main.js",
    "typeorm": "ts-node ./node_modules/typeorm/cli.js",
    "migration:generate": "pnpm run typeorm --dataSource=src/data-source.ts migration:generate",
    "migration:create": "pnpm run typeorm migration:create",
    "migration:run": "pnpm run typeorm --dataSource=src/data-source.ts migration:run",
    "migration:show": "pnpm run typeorm --dataSource=src/data-source.ts migration:show",
    "migration:revert": "pnpm run typeorm --dataSource=src/data-source.ts migration:revert",
    "schema:drop": "pnpm run typeorm --dataSource=src/data-source.ts schema:drop",
    "seed:run": "ts-node src/database/seed.ts",
    "watch:dev": "nest start --watch",
    "debug:dev": "nest start --debug --watch",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "cross-env NODE_ENV=test jest",
    "test:unit": "pnpm test",
    "test:watch": "cross-env NODE_ENV=test jest --watch",
    "test:cov": "cross-env NODE_ENV=test jest --coverage",
    "test:debug": "cross-env NODE_ENV=test node --inspect-brk -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "cross-env NODE_ENV=test jest --config ./test/jest-e2e.json --runInBand",
    "verify": "pnpm format:check && pnpm lint && pnpm type-check && pnpm type-check:compat && pnpm type-check:test && pnpm type-check:test:compat && pnpm build:prod && pnpm test && pnpm test:e2e",
    "prepare": "husky",
    "release": "release-it"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1085.0",
    "@nestjs-cls/transactional": "^3.2.1",
    "@nestjs-cls/transactional-adapter-typeorm": "^1.3.5",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.4.5",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.3",
    "bcrypt": "^6.0.0",
    "class-transformer": "~0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.1",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "libphonenumber-js": "^1.12.31",
    "lodash": "^4.18.1",
    "mime-types": "^3.0.2",
    "morgan": "^1.11.0",
    "nestjs-cls": "^6.2.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "typeorm": "^1.0.0",
    "zod": "^4.4.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".spec.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/../tsconfig.test.json"
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-angular": "^21.2.0",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.8.0",
    "@types/express": "^5.0.2",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.17",
    "@types/mime-types": "^2.1.4",
    "@types/morgan": "^1.9.9",
    "@types/node": "^24.10.0",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^3.0.13",
    "@types/supertest": "^6.0.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "cross-env": "^10.1.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^17.0.8",
    "oxlint": "1.73.0",
    "oxlint-tsgolint": "0.24.0",
    "prettier": "^3.9.5",
    "release-it": "^20.2.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "packageManager": "pnpm@11.12.0"
}
