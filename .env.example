NODE_ENV=development

# Application
PORT=3000
ENABLE_DOCUMENTATION=true
API_VERSION=v1.0.0
# Comma-separated allowlist. Leave empty to disable cross-origin requests.
CORS_ORIGINS=http://localhost:3000
# Number of trusted reverse-proxy hops. Keep 0 when directly exposed.
TRUST_PROXY_HOPS=0

# JWT authentication
# Generate a dedicated RSA key pair for each environment. Encode PEM newlines
# as \n when the deployment platform cannot store multiline values.
JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nreplace-with-your-key-material\n-----END PRIVATE KEY-----
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nreplace-with-your-key-material\n-----END PUBLIC KEY-----
JWT_ISSUER=awesome-nest-boilerplate
JWT_AUDIENCE=awesome-nest-api
JWT_EXPIRATION_TIME=3600
JWT_REFRESH_EXPIRATION_TIME=604800
# Benchmark for your deployment environment; accepted range is 10-15.
BCRYPT_ROUNDS=12

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=nest_boilerplate
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_DROP_SCHEMA=false
ENABLE_ORM_LOGS=true

# AWS S3
# The AWS SDK reads credentials from its standard credential provider chain.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_REGION=eu-central-1
AWS_S3_API_VERSION=2006-03-01
AWS_S3_BUCKET_NAME=nest-boilerplate-bucket

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Authorization cache TTL is in seconds
CACHE_USER_PERMISSIONS_TTL=300

# Throttling accepts human-readable durations; Nest receives milliseconds.
THROTTLER_TTL=1m
THROTTLER_LIMIT=10
